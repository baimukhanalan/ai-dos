{
  "compilerOptions": {
    "target": "ES2022",
    // DOM нужен не воркеру, а коду внутри page.evaluate: он выполняется в браузере.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
