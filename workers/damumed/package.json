{
  "name": "aidos-damumed-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Внешний воркер AI Dos: заводит записи в веб-интерфейсе DamuMed без официального API",
  "scripts": {
    "login": "tsx src/index.ts login",
    "discover": "tsx src/index.ts discover",
    "parse": "tsx src/index.ts parse",
    "run": "tsx src/index.ts run",
    "run:once": "tsx src/index.ts run --once",
    "run:dry": "tsx src/index.ts run --once --dry-run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
