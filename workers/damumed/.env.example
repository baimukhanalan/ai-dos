# --- AI Dos ---
AIDOS_BASE_URL=https://ai-dos-sage.vercel.app
# Тот же секрет, что задан в переменных окружения AI Dos
MIS_WORKER_SECRET=replace-with-a-long-random-secret

# --- DamuMed ---
# Адрес регистратуры вашего региона
DAMUMED_BASE_URL=https://reg-ala.dmed.kz
DAMUMED_DESKTOP_PATH=/Home/Desktop
CLINIC_TIMEZONE=Asia/Almaty

# Пароль здесь НЕ хранится: сессия сохраняется командой npm run login
DAMUMED_STORAGE_STATE=./storage-state.json
DAMUMED_ARTIFACTS_DIR=./artifacts

# false — показывать браузер (для отладки)
DAMUMED_HEADLESS=true
# Пауза между действиями: не создаём нагрузку на чужой сервер
DAMUMED_ACTION_DELAY_MS=400
DAMUMED_NAVIGATION_TIMEOUT_MS=30000
DAMUMED_STEP_TIMEOUT_MS=15000

# Сколько записей берём за прогон и как часто опрашиваем очередь
DAMUMED_BATCH_LIMIT=10
DAMUMED_POLL_INTERVAL_MS=60000

# Значения по умолчанию в форме записи
DAMUMED_PAYMENT_TYPE=Государственные
DAMUMED_PLACE_OF_SERVICE=В поликлинике
DAMUMED_REASON=Обращение через AI Dos
