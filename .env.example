DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=sk-replace-me
GEMINI_API_KEY=replace-with-google-ai-studio-key
OPENAI_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_APP_URL=http://localhost:3000
AI_RUNTIME=safe
MIS_ADAPTER=sandbox
MCP_TENANT_SLUG=clinic-slug
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-secret

# Доставка уведомлений. Канал включается только когда заданы обе переменные;
# без них сообщения ждут в статусе blocked и не теряются.
NOTIFY_CHANNEL_PRIORITY=whatsapp,sms,email,portal
NOTIFY_SMS_WEBHOOK_URL=
NOTIFY_SMS_TOKEN=
NOTIFY_WHATSAPP_WEBHOOK_URL=
NOTIFY_WHATSAPP_TOKEN=
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_EMAIL_TOKEN=
TELEGRAM_BOT_TOKEN=

# Операционные воркеры
WAITLIST_OFFER_TTL_MINUTES=120
NO_SHOW_GRACE_MINUTES=30
# Через сколько часов молчания диалог записи закрывается как «оборвался»
BOOKING_ABANDON_HOURS=6

# Внешняя МИС. sandbox — источник правды только AI Dos; damumed — официальный
# API (ждёт доступ); remote — очередь забирает воркер на отдельном хосте.
MIS_ADAPTER=sandbox
MIS_WORKER_SECRET=

# Платёжный провайдер владельца платформы; пусто — счёт выставляется вручную.
BILLING_PROVIDER=
